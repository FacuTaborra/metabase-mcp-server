# Copiar a .env y completar con valores reales: cp .env.example .env
#
# URL de Metabase. Como el MCP y Metabase comparten la red Docker,
# apunta al NOMBRE DEL SERVICIO de Metabase, no a localhost.
# Ej: http://metabase:3000
METABASE_URL=http://REEMPLAZAR_SERVICIO_METABASE:3000

# API key de Metabase (Admin settings -> Authentication -> API Keys)
METABASE_API_KEY=mb_xxx_tu_api_key

# Necesario para que sirva HTTP. Sin esto arranca en modo stdio y NO escucha en el puerto.
TRANSPORT=streamable-http

HOST=0.0.0.0
PORT=3200
LOG_LEVEL=INFO
